# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Публичный HTTPS-адрес, на который Telegram шлёт апдейты.
# Локально удобно поднять туннель (ngrok, cloudflared) на BOT_LISTEN_ADDR.
TELEGRAM_WEBHOOK_URL=

# Произвольная строка. Telegram шлёт её в заголовке каждого запроса,
# бот отбрасывает всё, что пришло без неё: адрес вебхука публичный.
TELEGRAM_WEBHOOK_SECRET=

# Необязательно, по умолчанию :2000.
BOT_LISTEN_ADDR=:2000
