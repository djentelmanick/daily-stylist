# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Публичный HTTPS-адрес сервера без пути, например адрес туннеля (ngrok, cloudflared).
# Полный адрес вебхука - этот адрес плюс TELEGRAM_WEBHOOK_PATH.
TELEGRAM_WEBHOOK_BASE_URL=

# Необязательно, по умолчанию /telegram/webhook. Пути /api/ заняты Mini App.
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Произвольная строка. Telegram шлёт её в заголовке каждого запроса,
# бот отбрасывает всё, что пришло без неё: адрес вебхука публичный.
TELEGRAM_WEBHOOK_SECRET=

# Необязательно, по умолчанию :2000.
BOT_LISTEN_ADDR=:2000

# deploy/docker-compose.yml берёт настройки отсюда.
POSTGRES_USER=stylist
POSTGRES_PASSWORD=stylist
POSTGRES_DB=stylist
POSTGRES_PORT=55432

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# База для интеграционных тестов, её создаёт deploy/postgres/init. Не указывайте здесь рабочую базу.
TEST_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/stylist_test

# Кэш прогноза погоды и суточный лимит распознаваний (Redis в deploy/docker-compose.yml).
REDIS_PORT=56379
REDIS_URL=redis://localhost:${REDIS_PORT}/0

# Redis для интеграционных тестов - отдельная база номер 1.
TEST_REDIS_URL=redis://localhost:${REDIS_PORT}/1

# Очередь задач утренней рассылки (RabbitMQ в deploy/docker-compose.yml).
# Панель брокера - http://localhost:${RABBITMQ_UI_PORT}, логин и пароль отсюда же.
RABBITMQ_USER=stylist
RABBITMQ_PASSWORD=stylist
RABBITMQ_PORT=55672
RABBITMQ_UI_PORT=55673
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:${RABBITMQ_PORT}/

# Брокер для интеграционных тестов - тот же, но очередь своя.
TEST_RABBITMQ_URL=${RABBITMQ_URL}

# Хранилище фотографий (SeaweedFS в deploy/docker-compose.yml).
S3_ACCESS_KEY=stylist
S3_SECRET_KEY=stylist-secret
S3_PORT=58333
S3_FILER_PORT=58888
S3_BUCKET=photos
S3_ENDPOINT=http://localhost:${S3_PORT}

# Адрес хранилища для браузера
S3_PUBLIC_URL=${TELEGRAM_WEBHOOK_BASE_URL}

# Необязательно, по умолчанию us-east-1. У облачного S3 регион будет настоящий.
S3_REGION=us-east-1

# Бакет для интеграционных тестов хранилища, создаётся при первой загрузке.
# Не указывайте здесь рабочий бакет: тесты в нём удаляют файлы.
TEST_S3_ENDPOINT=${S3_ENDPOINT}
TEST_S3_BUCKET=photos-test

# Для goose CLI
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=${DATABASE_URL}
GOOSE_MIGRATION_DIR=migrations

# Распознавание одежды на фотографии. Основной распознаватель и запасной на случай,
# когда основной не смог: gigachat - облачная модель, vision - свой сервис на Python.
# Запасного может не быть: тогда не распозналось - и ладно, поля заполнит человек.
RECOGNIZER=gigachat
RECOGNIZER_FALLBACK=

# Ключ авторизации GigaChat (Basic, из личного кабинета). Нужен, если gigachat используется.
GIGACHAT_AUTH_KEY=
# GIGACHAT_MODEL=GigaChat-3-Ultra

# Свой сервис распознавания: поднимается профилем vision в deploy/docker-compose.yml.
VISION_PORT=59090
VISION_ADDR=localhost:${VISION_PORT}
